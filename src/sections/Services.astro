---
// ============================================================
// Services.astro — Sectors We Power (Clean Human Engineering)
// Replaces redundant 7-service catalogue with high-impact client sectors
// Directs detailed inquiries to the dedicated /services/ page
// 100% responsive, ultra-fast, zero-scroll-jacking
// ============================================================

const sectors = [
  {
    title: 'Industrial Plants & Substations',
    subtitle: 'Manufacturing plants, mills, factories & processing units',
    summary: 'Turnkey 11kV substation erection, high-voltage transformers, custom motor control centers (MCC), and plant earthing systems engineered for continuous 24/7 uptime.',
    tags: ['11kV Substations', 'HT/LT Switchgear', 'Plant Earthing', 'KEB Compliance'],
    image: '/images/services/industrial-power.webp',
    href: '/services/#industrial-power',
    cta: 'View Industrial Solutions',
  },
  {
    title: 'Commercial & Healthcare Facilities',
    subtitle: 'Hospitals, IT parks, commercial centers & campuses',
    summary: 'Mission-critical power resilience with automated generator synchronization (ATS/AMF), structured data cabling, energy metering, and integrated life-safety systems.',
    tags: ['Automatic Transfer Switches', 'Structured Data Cabling', 'CCTV & Security', 'Power Audits'],
    image: '/images/services/ats-panel.webp',
    href: '/services/#ats-amf-panels',
    cta: 'View Commercial Solutions',
  },
  {
    title: 'Residential & Villa Estates',
    subtitle: 'Luxury villas, residential complexes & gated communities',
    summary: 'Concealed fire-retardant wiring, high-sensitivity RCCB shock protection, smart lighting automation, and clean distribution board design for modern living.',
    tags: ['Concealed Conduit Wiring', 'Smart Automation', 'RCCB Shock Protection', 'Lighting Design'],
    image: '/images/services/home-electrical.webp',
    href: '/services/#home-electrical',
    cta: 'View Residential Solutions',
  },
];
---

<section
  id="services"
  class="relative w-full pt-20 sm:pt-28 pb-16 sm:pb-24 bg-[#07131D] text-white border-t border-white/10 overflow-hidden"
  aria-labelledby="sectors-heading"
>
  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
    
    <!-- ── SECTION HEADER ────────────────────────────────────── -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-10 sm:mb-14">
      <div class="max-w-2xl">
        <span class="text-xs sm:text-sm font-semibold tracking-wider uppercase text-[#00A6A6] block mb-2">Our Engineering Divisions</span>
        
        <h2 id="sectors-heading" class="font-display text-2xl sm:text-3xl lg:text-4xl font-normal text-white tracking-tight leading-tight">
          Targeted Power Solutions. <br/>
          <span class="font-semibold text-white">Engineered for Every Sector.</span>
        </h2>
        <p class="text-sm sm:text-base text-[#D9E0E5]/75 font-normal leading-relaxed mt-3 max-w-xl">
          Every project receives specialized engineering, statutory KEB compliance, and certified hardware tailored to its operational scale.
        </p>
      </div>

      <div class="flex items-center gap-4 flex-shrink-0">
        <a
          href="/services/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[#00A6A6] hover:text-[#22D3EE] transition-colors group"
        >
          <span>View All Services</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- ── 3 SECTOR CARDS (Clean, Human, Non-AI) ── -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 mb-12 sm:mb-16">
      {sectors.map((sector) => (
        <article class="group flex flex-col justify-between rounded-2xl bg-[#0B1A28] border border-white/10 hover:border-[#00A6A6]/60 transition-all duration-300 shadow-lg hover:shadow-xl overflow-hidden">
          
          <!-- Clean Image Header (No badges on photo) -->
          <div class="relative w-full aspect-[16/10] overflow-hidden">
            <img
              src={sector.image}
              alt={sector.title}
              width="640"
              height="400"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B1A28] via-[#0B1A28]/30 to-transparent"></div>
          </div>

          <!-- Body Content -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-display text-xl sm:text-2xl font-semibold text-white tracking-tight mb-1.5">
                {sector.title}
              </h3>
              <p class="text-xs text-[#00A6A6] font-medium mb-3">
                {sector.subtitle}
              </p>
              <p class="text-sm text-[#D9E0E5]/80 font-normal leading-relaxed mb-5">
                {sector.summary}
              </p>

              <!-- Clean Feature Tags -->
              <div class="flex flex-wrap gap-2 mb-6 pt-4 border-t border-white/10">
                {sector.tags.map((tag) => (
                  <span class="inline-block px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-white/80 text-xs font-normal">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Single Clear Action Link -->
            <a
              href={sector.href}
              class="inline-flex items-center justify-between w-full px-5 py-3 rounded-xl bg-white/10 hover:bg-[#00A6A6] text-white text-sm font-semibold tracking-wide transition-all duration-200 group/btn"
            >
              <span>{sector.cta}</span>
              <svg class="w-4 h-4 transition-transform duration-200 group-hover/btn:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- ── BOTTOM BRIDGE: LINK TO DETAILED SERVICES PAGE ─────── -->
    <div class="relative rounded-2xl bg-[#0B1A28] border border-white/10 p-6 sm:p-8 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6 overflow-hidden">
      <div class="relative z-10 max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#00A6A6] block mb-2">Technical Services & Compliance</span>
        <h3 class="font-display text-lg sm:text-xl font-semibold text-white tracking-tight mb-1.5">
          Looking for specific technical requirements?
        </h3>
        <p class="text-xs sm:text-sm text-[#D9E0E5]/75 font-normal leading-relaxed">
          From single-line diagrams (SLD) and custom ATS switchgear to structured data cabling, CCTV security, and 24/7 priority maintenance — explore our complete engineering services.
        </p>
      </div>

      <div class="relative z-10 flex flex-wrap items-center gap-3 w-full sm:w-auto flex-shrink-0">
        <a
          href="/services/"
          class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-full bg-[#00A6A6] hover:bg-[#008E8E] text-white font-semibold text-xs sm:text-sm tracking-wide transition-all shadow-md hover:shadow-[#00A6A6]/25 w-full sm:w-auto text-center"
        >
          <span>View All Services</span>
          <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 sm:py-3 rounded-full bg-white/[0.06] hover:bg-white/[0.12] text-white/90 hover:text-white border border-white/15 hover:border-white/30 text-xs sm:text-sm font-medium transition-all w-full sm:w-auto text-center"
        >
          <span>Contact an Engineer</span>
        </a>
      </div>
    </div>

  </div>
</section>
