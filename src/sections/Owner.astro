---
// ============================================================
// Owner.astro — Authentic Leadership & Direct Accountability
// Highlights the owner/founder with real photography before the footer
// ============================================================
import { company } from '@data/company';
---

<section
  id="leadership"
  class="relative w-full py-16 sm:py-20 lg:py-24 bg-[#071827] text-white border-t border-white/10 overflow-hidden"
  aria-labelledby="leadership-heading"
>
  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- Left: Real Photo of the Owner -->
      <div class="lg:col-span-5 flex justify-center lg:justify-start">
        <div class="relative w-full max-w-[380px] sm:max-w-[420px] rounded-2xl overflow-hidden border border-white/15 shadow-2xl bg-[#0B1A28] group">
          <picture>
            <source srcset="/images/owner.webp" type="image/webp" />
            <img
              src="/images/owner.jpeg"
              alt="Lead Electrical Engineer and Founder of Bright Electrical"
              width="1086"
              height="1448"
              class="w-full h-auto aspect-[3/4] object-cover object-center filter brightness-[0.98] transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </picture>
          
          <!-- Subtle bottom gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#071827]/90 via-transparent to-transparent pointer-events-none"></div>

          <!-- Role Card on Image -->
          <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#071827]/90 backdrop-blur-md border border-white/10 shadow-lg">
            <p class="text-white font-semibold text-base sm:text-lg tracking-tight font-display">
              Lead Electrical Engineer
            </p>
            <p class="text-xs text-[#00A6A6] font-medium mt-0.5">
              Founder • Bright Electrical & Engineering Works
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Direct Accountability & Craftsmanship Guarantee -->
      <div class="lg:col-span-7">
        <span class="text-xs sm:text-sm font-semibold tracking-wider uppercase text-[#00A6A6] block mb-3">
          Direct Leadership & Accountability
        </span>

        <h2 id="leadership-heading" class="font-display text-2xl sm:text-3xl lg:text-4xl font-normal text-white tracking-tight leading-tight mb-5">
          "Every Project Receives Direct Engineer Oversight."
        </h2>

        <div class="space-y-4 text-sm sm:text-base text-[#D9E0E5]/80 font-normal leading-relaxed mb-8 max-w-2xl">
          <p>
            When you hire Bright Electrical, you work directly with master electricians who take personal responsibility for every circuit, distribution panel, and cable run.
          </p>
          <p>
            From residential villa wiring in Nilambur to 11kV industrial substations across Kerala, we never cut corners on wire gauges, thermal safety, or statutory KEB compliance.
          </p>
        </div>

        <!-- Trust Highlights -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8 pt-6 border-t border-white/10">
          <div>
            <p class="text-white font-bold text-lg sm:text-xl font-display">15+ Years</p>
            <p class="text-xs text-white/60">Hands-On Experience</p>
          </div>
          <div>
            <p class="text-white font-bold text-lg sm:text-xl font-display">Direct</p>
            <p class="text-xs text-white/60">Engineer Supervision</p>
          </div>
          <div>
            <p class="text-white font-bold text-lg sm:text-xl font-display">100% Safety</p>
            <p class="text-xs text-white/60">KEB Code Compliant</p>
          </div>
        </div>

        <!-- Direct Contact CTAs -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4">
          <a
            href={`tel:${company.phone}`}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#00A6A6] hover:bg-[#008E8E] text-white font-semibold text-sm tracking-wide transition-all shadow-md"
            aria-label={`Call lead engineer at ${company.phoneDisplay}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 11.5a19.79 19.79 0 01-3.07-8.67A2 2 0 012.18 1h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 8.1a16 16 0 006 6l1.41-1.41a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 15z"/>
            </svg>
            <span>Speak with Lead Engineer</span>
          </a>

          <a
            href={company.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/20 transition-all"
            aria-label="Chat on WhatsApp"
          >
            <span>Chat on WhatsApp</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
